generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  notes       Note[]
  id          Int       @id @default(autoincrement())
  name        String
  pinHash     String
  role        String
  active      Boolean   @default(true)
  failures    Int       @default(0)
  lockedUntil DateTime?
  sessions    Session[]
  shifts      Shift[]
  sales       Sale[]
  createdAt   DateTime  @default(now())
}

model Note {
  productId  Int?
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  dueAt      DateTime?
  id         Int       @id @default(autoincrement())
  title      String
  body       String
  resolved   Boolean   @default(false)
  version    Int       @default(0)
  authorId   Int
  author     Employee  @relation(fields: [authorId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([createdAt])
  @@index([customerId, resolved])
  @@index([productId, resolved])
}

model Session {
  id         String   @id
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  expiresAt  DateTime
}

model Product {
  purchaseLines PurchaseLine[]
  lots ProductLot[]
  version    Int              @default(0)
  notes      Note[]
  id         Int              @id @default(autoincrement())
  name       String
  barcode    String?          @unique
  category   String           @default("General")
  unit       String           @default("UNIDAD")
  cost       Decimal?         @db.Decimal(18, 2)
  price      Decimal          @db.Decimal(18, 2)
  stock      Decimal          @default(0) @db.Decimal(18, 3)
  minimum    Decimal          @default(0) @db.Decimal(18, 3)
  active     Boolean          @default(true)
  lines      SaleLine[]
  movements  StockMovement[]
  rules      PriceRule[]
  offers     SupplierOffer[]
  importItem ImportedProduct?
  createdAt  DateTime         @default(now())
}

model Customer {
  creditUnlimited Boolean @default(false)
  notes       Note[]
  containers  ContainerMovement[]
  id          Int                 @id @default(autoincrement())
  name        String
  phone       String              @default("")
  creditLimit Decimal             @default(0) @db.Decimal(18, 2)
  balance     Decimal             @default(0) @db.Decimal(18, 2)
  active      Boolean             @default(true)
  movements   AccountMovement[]
  sales       Sale[]
}

model Shift {
  id         Int               @id @default(autoincrement())
  employeeId Int
  employee   Employee          @relation(fields: [employeeId], references: [id])
  opening    Decimal           @db.Decimal(18, 2)
  openedAt   DateTime          @default(now())
  closedAt   DateTime?
  declared   Decimal?          @db.Decimal(18, 2)
  expected   Decimal?          @db.Decimal(18, 2)
  difference Decimal?          @db.Decimal(18, 2)
  sales      Sale[]
  movements  CashMovement[]
  accounts   AccountMovement[]
}

model Sale {
  returns      SaleReturn[]
  stockTracked Boolean      @default(true)
  id           Int          @id @default(autoincrement())
  requestKey   String       @unique
  requestHash  String       @default("")
  employeeId   Int
  employee     Employee     @relation(fields: [employeeId], references: [id])
  shiftId      Int
  shift        Shift        @relation(fields: [shiftId], references: [id])
  customerId   Int?
  customer     Customer?    @relation(fields: [customerId], references: [id])
  pendingName  String?
  status       String       @default("COMPLETADA")
  subtotal     Decimal      @db.Decimal(18, 2)
  surcharge    Decimal      @default(0) @db.Decimal(18, 2)
  total        Decimal      @db.Decimal(18, 2)
  quickAmount  Decimal      @default(0) @db.Decimal(18, 2)
  createdAt    DateTime     @default(now())
  voidedAt     DateTime?
  voidReason   String?
  lines        SaleLine[]
  payments     Payment[]

  @@index([createdAt])
  @@index([employeeId])
  @@index([customerId])
  @@index([status, id])
}

model SaleReturn {
  requestHash String
  id          Int      @id @default(autoincrement())
  requestKey  String   @unique
  saleId      Int
  sale        Sale     @relation(fields: [saleId], references: [id])
  amount      Decimal  @db.Decimal(18, 2)
  method      String
  restock     Boolean
  reason      String
  employeeId  Int
  adminId     Int
  lineDetails String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model PosSettings {
  employeeSurchargeLimit Decimal @default(0) @db.Decimal(18, 2)
  employeeMovementLimit Decimal @default(0) @db.Decimal(18, 2)
  id           Int     @id @default(1)
  stockEnabled Boolean @default(true)
  version      Int     @default(0)
}

model SaleLine {
  id        Int      @id @default(autoincrement())
  saleId    Int
  sale      Sale     @relation(fields: [saleId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  name      String
  quantity  Decimal  @db.Decimal(18, 3)
  unitPrice Decimal  @db.Decimal(18, 2)
  unitCost  Decimal? @db.Decimal(18, 2)
  total     Decimal  @db.Decimal(18, 2)
}

model Payment {
  id        Int      @id @default(autoincrement())
  saleId    Int
  sale      Sale     @relation(fields: [saleId], references: [id])
  method    String
  amount    Decimal  @db.Decimal(18, 2)
  shiftId   Int
  createdAt DateTime @default(now())
}

model StockMovement {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Decimal  @db.Decimal(18, 3)
  reason     String
  saleId     Int?
  employeeId Int
  createdAt  DateTime @default(now())
}

model AccountMovement {
  requestKey String? @unique
  requestHash String?
  method String @default("EFECTIVO")
  reference String @default("")
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Decimal  @db.Decimal(18, 2)
  kind       String
  saleId     Int?
  shiftId    Int?
  shift      Shift?   @relation(fields: [shiftId], references: [id])
  employeeId Int
  createdAt  DateTime @default(now())
}

model CashMovement {
  category String @default("SIN_CLASIFICAR")
  id         Int      @id @default(autoincrement())
  shiftId    Int
  shift      Shift    @relation(fields: [shiftId], references: [id])
  amount     Decimal  @db.Decimal(18, 2)
  reason     String
  employeeId Int
  saleId     Int?
  createdAt  DateTime @default(now())
}

model Audit {
  id         Int      @id @default(autoincrement())
  employeeId Int?
  action     String
  entity     String
  detail     String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model PriceRule {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  minimum   Decimal @db.Decimal(18, 3)
  unitPrice Decimal @db.Decimal(18, 2)
}

model Supplier {
  purchases Purchase[]
  notes   Note[]
  id      Int             @id @default(autoincrement())
  name    String
  contact String          @default("")
  offers  SupplierOffer[]
}

model SupplierOffer {
  id         Int      @id @default(autoincrement())
  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  cost       Decimal  @db.Decimal(18, 2)
  updatedAt  DateTime @updatedAt

  @@unique([supplierId, productId])
}

model Shortage {
  id        Int      @id @default(autoincrement())
  note      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CashWithdrawal {
  id            Int      @id @default(autoincrement())
  shiftId       Int
  employeeId    Int
  method        String
  mode          String
  cashAmount    Decimal  @db.Decimal(18, 2)
  digitalAmount Decimal  @db.Decimal(18, 2)
  commission    Decimal  @db.Decimal(18, 2)
  createdAt     DateTime @default(now())
}

model ProductImport {
  id          Int               @id @default(autoincrement())
  sourceName  String
  sourceHash  String            @unique
  sheetName   String
  recordCount Int
  skipped     Int               @default(0)
  createdAt   DateTime          @default(now())
  items       ImportedProduct[]
}

model ImportedProduct {
  id             Int           @id @default(autoincrement())
  importId       Int
  batch          ProductImport @relation(fields: [importId], references: [id])
  sourceRow      Int
  name           String
  normalizedKey  String        @unique
  unit           String
  referencePrice Decimal       @db.Decimal(18, 2)
  barcode        String?
  productId      Int?          @unique
  product        Product?      @relation(fields: [productId], references: [id])
  reviewedAt     DateTime?

  @@unique([importId, sourceRow])
  @@index([barcode])
}

// La migración mantiene esta tabla mediante triggers; no se modifica desde la UI.
model BarcodeReservation {
  barcode String @id
  owner   String @unique
}

model ContainerMovement {
  id         Int      @id @default(autoincrement())
  requestKey String   @unique
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  kind       String
  quantity   Int
  reason     String
  employeeId Int
  createdAt  DateTime @default(now())

  @@index([customerId, id])
}

model Purchase {
  id Int @id @default(autoincrement())
  requestKey String @unique
  requestHash String
  supplierId Int
  supplier Supplier @relation(fields: [supplierId], references: [id])
  document String
  total Decimal @db.Decimal(18,2)
  expenses Decimal @db.Decimal(18,2)
  employeeId Int
  createdAt DateTime @default(now())
  lines PurchaseLine[]
  payments SupplierPayment[]
  @@index([supplierId, createdAt])
}
model PurchaseLine {
  id Int @id @default(autoincrement())
  purchaseId Int
  purchase Purchase @relation(fields: [purchaseId], references: [id])
  productId Int
  product Product @relation(fields: [productId], references: [id])
  name String
  quantity Decimal @db.Decimal(18,3)
  unitCost Decimal @db.Decimal(18,2)
  previousCost Decimal? @db.Decimal(18,2)
  newCost Decimal @db.Decimal(18,2)
  total Decimal @db.Decimal(18,2)
  lot ProductLot?
}
model ProductLot {
  id Int @id @default(autoincrement())
  productId Int
  product Product @relation(fields: [productId], references: [id])
  purchaseLineId Int? @unique
  purchaseLine PurchaseLine? @relation(fields: [purchaseLineId], references: [id])
  code String
  quantity Decimal @db.Decimal(18,3)
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  expiresAt DateTime?
  @@index([productId, expiresAt])
}
model SupplierPayment {
  id Int @id @default(autoincrement())
  requestKey String @unique
  requestHash String
  purchaseId Int
  purchase Purchase @relation(fields: [purchaseId], references: [id])
  amount Decimal @db.Decimal(18,2)
  method String
  reference String
  employeeId Int
  createdAt DateTime @default(now())
}
