{
  "name": "el-universo-pos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "demo": "tsx scripts/demo.ts",
    "setup": "node scripts/setup.mjs",
    "import:catalog": "tsx scripts/import-catalog.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "decimal.js": "10.6.0",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0",
    "lucide-react": "0.468.0",
    "pdfkit": "0.17.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.9.1",
    "@types/pdfkit": "0.17.3",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.5",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
